#!/usr/bin/env bash
#MISE description="Run BATS and Python tests"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" var=#true default="" help="BATS files, directories, and arguments"
#USAGE example "mise run test" header="Run all BATS and Python tests"
#USAGE example "mise run test test/pull_request_gate.bats" header="Run one BATS test file"
#USAGE example "mise run test --filter doctor" header="Filter BATS tests by name"
set -euo pipefail

export BATS_DEFAULT_TEST_TARGET="$MISE_CONFIG_ROOT/test"

run_python=false
if [ "$#" -eq 0 ]; then
  run_python=true
fi

bats --print-output-on-failure "$@"

$run_python || exit 0
exec mise -C "$MISE_CONFIG_ROOT" run python:test
